BASE_PATH=/
PORT=3000
VITE_API_BASE_URL=http://localhost:3001

# Google OAuth client ID (public identifier, safe to expose to the browser).
# Create one at https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# Payment gateway placeholders.
# Keep secrets on the API/server side. Frontend should only use public checkout config.
VITE_PAYMENT_GATEWAY=trial
VITE_PINE_LABS_CHECKOUT_MODE=sandbox
